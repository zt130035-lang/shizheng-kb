.hero-note{margin-top:14rpx;color:rgba(255,255,255,.82);font-size:23rpx;line-height:1.5}
.retry-btn{margin-top:20rpx}

.q-picker{display:flex;flex-wrap:wrap;gap:12rpx}
.batch-btn{margin-top:18rpx;width:100%}
.batch-tip{margin-top:12rpx;color:#8A93A6;font-size:23rpx;line-height:1.6}
.q-chip{padding:10rpx 20rpx;border:1rpx solid #D5DCE8;border-radius:14rpx;background:#FFFFFF;color:#5B6472;font-size:24rpx;line-height:1.4}
.q-chip.active{border-color:#2F6BFF;background:#2F6BFF;color:#FFFFFF;font-weight:700}

.q-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.q-score{color:#2F6BFF;font-size:26rpx;font-weight:800;white-space:nowrap}
.q-task{margin-top:16rpx;color:#1C2740;font-size:28rpx;line-height:1.75;word-break:break-word}
.q-ref{margin-top:12rpx;color:#8A93A6;font-size:23rpx}

.material-toggle{margin-top:18rpx;padding:14rpx 0;color:#2F6BFF;font-size:25rpx}
.material-body{margin-top:8rpx;max-height:900rpx;overflow-y:auto;padding:18rpx;border-radius:16rpx;background:#F7FAFF;color:#3A4A63;font-size:25rpx;line-height:1.8;white-space:pre-wrap;word-break:break-word}

.answer-source{display:inline-block;margin-top:14rpx;padding:6rpx 16rpx;border-radius:999rpx;background:#EEF1F6;color:#5B6472;font-size:22rpx}
.answer-source.ai{background:#FFF1E0;color:#B4701F}
.answer-body{margin-top:6rpx;color:#1C2740;font-size:27rpx;line-height:1.85;white-space:pre-wrap;word-break:break-word}

.action-row{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:18rpx}
.btn-inline{flex:1 1 200rpx;min-width:0}
.btn[disabled]{opacity:.55;background:#A9B4C6!important;color:#FFFFFF!important}
.btn.secondary[disabled]{opacity:.55;background:#EEF1F6!important;color:#8A93A6!important}

.point-line{margin:10rpx 0;color:#3A4A63;font-size:26rpx;line-height:1.75;word-break:break-word}
.block-text{color:#3A4A63;font-size:26rpx;line-height:1.8;white-space:pre-wrap;word-break:break-word}

.ai-result{margin-top:20rpx;padding-top:18rpx;border-top:1rpx solid #EDF0F7}
.ai-result-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:12rpx}
.ai-result-title{color:#1C2740;font-size:27rpx;font-weight:800}
.mini-btn{margin:0;padding:0 20rpx;min-height:54rpx;line-height:54rpx;border-radius:16rpx;background:#EEF1F6;color:#2F6BFF;font-size:23rpx}
.mini-btn::after{border:0}
.ai-disclaimer{margin-top:14rpx;color:#8A93A6;font-size:22rpx;line-height:1.6}

.small-empty{padding:32rpx 12rpx}
.material-missing{margin-top:14rpx;padding:12rpx 16rpx;border-radius:14rpx;background:#FFF7EB;color:#9A6A1F;font-size:23rpx;line-height:1.6}
.guide-card{background:#F7FAFF}
.tip-line{font-size:25rpx;color:#5B6472;line-height:1.75;margin:8rpx 0}