.feature-card{min-height:150rpx}
.feature-icon{width:76rpx;height:76rpx;border-radius:20rpx;background:#EEF3FF;display:flex;align-items:center;justify-content:center;font-size:40rpx;margin-bottom:14rpx}
.soon-tag{display:inline-block;margin-left:10rpx;padding:2rpx 10rpx;border-radius:99rpx;background:#FFF1E0;color:#E08A2E;font-size:18rpx;font-weight:600;vertical-align:middle}
.step{display:flex;gap:18rpx;padding:14rpx 0}
.step-index{width:42rpx;height:42rpx;border-radius:50%;background:#2F6BFF;color:#FFFFFF;display:flex;align-items:center;justify-content:center;font-size:24rpx;font-weight:800;flex:0 0 42rpx}
.step-title{font-size:28rpx;font-weight:800;color:#1C2740}
.step-desc{margin-top:6rpx;color:#8A93A6;font-size:24rpx;line-height:1.55}
.action-panel{display:flex;gap:18rpx;flex-wrap:wrap}
.action-panel .btn{flex:1 1 260rpx}