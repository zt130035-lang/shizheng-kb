.mine-hero{background:linear-gradient(135deg,#2F6BFF,#5B8CFF 100%)}
.result-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.mini-btn{margin:0;padding:0 20rpx;min-height:58rpx;line-height:58rpx;border-radius:18rpx;background:#EEF1F6;color:#2F6BFF;font-size:24rpx}
.ghost-mini{min-height:48rpx;line-height:48rpx;font-size:22rpx;background:#E9EDF4}
.small-empty{padding:32rpx 12rpx}
.record-item{padding:18rpx 0;border-bottom:1rpx solid rgba(47,107,255,.08)}
.record-item:last-child{border-bottom:0}
.record-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.record-title{font-size:28rpx;font-weight:800;color:#1C2740;line-height:1.45;flex:1}
.record-time{margin-top:8rpx;color:#8A93A6;font-size:22rpx}
.record-summary{margin-top:10rpx;color:#5B6472;font-size:25rpx;line-height:1.6}
.tip-line{font-size:25rpx;color:#5B6472;line-height:1.75;margin:8rpx 0}