<view class="container">
  <view class="hero mine-hero">
    <view class="hero-title">我的</view>
    <view class="hero-subtitle">查看记录和设置。</view>
  </view>

  <view class="section card">
    <view class="result-head">
      <view class="section-title">最近批改</view>
      <button class="mini-btn" wx:if="{{records.length}}" bindtap="clearRecords">清空</button>
    </view>
    <view class="divider"></view>

    <view wx:if="{{!records.length}}" class="empty small-empty">暂无批改记录</view>

    <view wx:for="{{records}}" wx:key="id" class="record-item">
      <view class="record-head">
        <view class="record-title">{{item.topic}}</view>
        <button class="mini-btn ghost-mini" data-id="{{item.id}}" bindtap="copyRecord">复制</button>
      </view>
      <view class="record-time">{{item.time}}</view>
      <view class="record-summary">{{item.summary}}</view>
    </view>
  </view>

  <view class="section card">
    <view class="section-title">接口地址（调试）</view>
    <view class="divider"></view>
    <view class="tip-line">当前：{{baseUrl}}</view>
    <view class="tip-line">模拟器调本地后端填 http://127.0.0.1:5678，并勾选「不校验合法域名」；真机会自动回落线上地址。</view>
    <input class="input base-input" value="{{baseUrlInput}}" bindinput="onBaseUrlInput" placeholder="https://shizheng-kb.onrender.com" />
    <view class="base-actions">
      <button class="mini-btn" bindtap="saveBaseUrl">保存</button>
      <button class="mini-btn ghost-mini" bindtap="resetBaseUrl">恢复线上</button>
    </view>
  </view>

  <view class="section card">
    <view class="section-title">真题库</view>
    <view class="divider"></view>
    <view class="tip-line">导入整卷真题（PDF/Word/TXT/MD），AI 自动拆题入库，可在「真题」tab 查看和仿写。</view>
    <button class="import-btn" bindtap="chooseExamFile" disabled="{{importing}}">{{importing ? '导入中…' : '导入整卷真题'}}</button>
  </view>

  <view class="section card">
    <view class="section-title">说明</view>
    <view class="divider"></view>
    <view class="tip-line" wx:for="{{tips}}" wx:key="*this">{{index + 1}}. {{item}}</view>
  </view>
</view>
