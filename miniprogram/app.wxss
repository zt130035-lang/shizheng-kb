page { min-height: 100vh; background:#F5F7FA; color:#1C2740; font-size:28rpx; font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif; }
.container { padding:28rpx; box-sizing:border-box; }
.hero { padding:34rpx; border-radius:36rpx; color:#fff; background:linear-gradient(135deg,#2F6BFF,#5B8CFF 100%); box-shadow:0 24rpx 60rpx rgba(47,107,255,.25); }
.hero-title { font-size:44rpx; font-weight:850; letter-spacing:-1rpx; }
.hero-subtitle { margin-top:12rpx; color:rgba(255,255,255,.85); line-height:1.65; font-size:25rpx; }
.section { margin-top:30rpx; }
.section-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:18rpx; }
.section-title { font-size:34rpx; font-weight:850; color:#1C2740; }
.section-more { color:#2F6BFF; font-size:25rpx; }
.grid { display:grid; grid-template-columns:1fr 1fr; gap:18rpx; }
.card { background:#fff; border:1rpx solid rgba(47,107,255,.08); border-radius:28rpx; padding:24rpx; box-shadow:0 14rpx 42rpx rgba(30,60,130,.06); }
.card-title { font-size:29rpx; font-weight:760; color:#1C2740; line-height:1.45; }
.card-meta { margin-top:10rpx; color:#8A93A6; font-size:23rpx; line-height:1.5; }
.stat-value { font-size:44rpx; font-weight:850; color:#2F6BFF; }
.stat-label { margin-top:8rpx; color:#8A93A6; font-size:23rpx; }
.list { display:flex; flex-direction:column; gap:18rpx; }
.tag { display:inline-flex; padding:6rpx 14rpx; border-radius:999rpx; background:#EEF3FF; color:#2F6BFF; font-size:22rpx; }
.btn { display:flex; align-items:center; justify-content:center; min-height:72rpx; padding:0 24rpx; border-radius:22rpx; background:#2F6BFF; color:#fff; font-size:27rpx; font-weight:750; }
.btn.secondary { background:#EEF1F6; color:#3A4A63; }
.btn.ghost { background:transparent; color:#2F6BFF; border:1rpx solid rgba(47,107,255,.3); }
.input,.textarea { width:100%; box-sizing:border-box; background:#fff; border:1rpx solid rgba(47,107,255,.14); border-radius:24rpx; padding:22rpx 24rpx; color:#1C2740; font-size:28rpx; }
.textarea { min-height:210rpx; line-height:1.6; }
.empty { padding:60rpx 28rpx; text-align:center; color:#8A93A6; }
.rich { line-height:1.85; font-size:28rpx; color:#1C2740; }
.divider { height:1rpx; background:rgba(47,107,255,.08); margin:24rpx 0; }
.row { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.good { color:#1F9D55; } .bad { color:#E5484D; }

.status-card { margin-top: 22rpx; padding: 22rpx 24rpx; border-radius: 24rpx; background: #fff; color: #8A93A6; border: 1rpx solid rgba(47,107,255,.08); line-height: 1.6; font-size: 26rpx; }
.status-card.error { color: #E5484D; background: #FFF1F0; }
